# ==============================================================================
# Latch Environment Configuration Example
# Copy this file to .env or pass these as environment variables in Docker.
# NEVER commit real credentials, tokens, or PINs to version control.
# ==============================================================================

# Server Network Configuration
PORT=8082
HOST=0.0.0.0

# Optional Delivery PIN Code default (6 digits)
PINCODE=

# Optional WhatsApp Push Notifications (via CallMeBot free API)
# 1. Add CallMeBot on WhatsApp to get your free API key.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# Watcher Polling Timing (in milliseconds)
POLL_MIN_MS=6000
POLL_MAX_MS=40000
ORDER_COOLDOWN_MS=2700000

# Automated Order Settings
AUTO_ORDER=false
ORDER_IF_ALREADY_IN_STOCK=false
